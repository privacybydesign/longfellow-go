 lib/circuits/mdoc/mdoc_circuit_id.cc |  3 ++-
 lib/circuits/mdoc/mdoc_decompress.cc | 16 ++++++++++++++++
 lib/circuits/mdoc/mdoc_zk.cc         |  6 ++++--
 3 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/lib/circuits/mdoc/mdoc_circuit_id.cc b/lib/circuits/mdoc/mdoc_circuit_id.cc
index b9ca1eb..7083431 100644
--- a/lib/circuits/mdoc/mdoc_circuit_id.cc
+++ b/lib/circuits/mdoc/mdoc_circuit_id.cc
@@ -48,7 +48,8 @@ int circuit_id(uint8_t id[/*kSHA256DigestSize*/], const uint8_t* bcp,
   uint8_t cid[kSHA256DigestSize];
 
   size_t len = kCircuitSizeMax;
-  std::vector<uint8_t> bytes(len);
+  std::vector<uint8_t> bytes;  // sized by decompress from the frame header
+  (void)len;
   size_t full_size = decompress(bytes, bcp, bcsz);
 
   ReadBuffer rb_circuit(bytes.data(), full_size);
diff --git a/lib/circuits/mdoc/mdoc_decompress.cc b/lib/circuits/mdoc/mdoc_decompress.cc
index fcd6a5c..4bf3d64 100644
--- a/lib/circuits/mdoc/mdoc_decompress.cc
+++ b/lib/circuits/mdoc/mdoc_decompress.cc
@@ -21,6 +21,8 @@
 #include "util/log.h"
 #include "zstd.h"
 
+#include "circuits/mdoc/mdoc_zk.h"
+
 namespace proofs {
 
 // Decompress a circuit representation into a vector that has been reserved
@@ -28,6 +30,20 @@ namespace proofs {
 // the size of the uncompressed string.
 size_t decompress(std::vector<uint8_t>& bytes, const uint8_t* compressed,
                   size_t compressed_len) {
+  // Size the output buffer from the frame header rather than from the
+  // kCircuitSizeMax upper bound. Constructing a std::vector of that bound
+  // value-initialises 130 MB -- every page written, so every page resident --
+  // when the v6 circuit needs only 87.7 MB of it.
+  unsigned long long fcs = ZSTD_getFrameContentSize(compressed, compressed_len);
+  size_t want = kCircuitSizeMax;
+  if (fcs != ZSTD_CONTENTSIZE_ERROR && fcs != ZSTD_CONTENTSIZE_UNKNOWN &&
+      fcs <= (unsigned long long)kCircuitSizeMax) {
+    want = (size_t)fcs;
+  }
+  if (bytes.size() < want) {
+    bytes.resize(want);
+  }
+
   size_t res =
       ZSTD_decompress(bytes.data(), bytes.size(), compressed, compressed_len);
 
